---
import Navigation from "../components/Navigation.astro";
import { getImage } from "astro:assets";
import logoSource from "../assets/richmond-barbershop-social.png";
import logoVector from "../assets/richmond-barbershop-logo.svg?url";
import heroImage from "../assets/hero.webp";
import {
  ADDRESS,
  BOOKING_URL,
  BUSINESS_HOURS_NOTE,
  BUSINESS_NAME,
  BUSINESS_DESCRIPTION,
  APPLE_MAPS_URL,
  FACEBOOK_URL,
  GOOGLE_PROFILE_URL,
  INSTAGRAM_URL,
  MAPS_URL,
  PHONE_DISPLAY,
  PHONE_E164,
  SERVICE_AREAS,
  SERVICES,
  WEBSITE_URL,
} from "../data/business";

const defaultTitle = `${BUSINESS_NAME} | Barber in Richmond, VA`;
const logoImage = await getImage({ src: logoSource, width: 1200, format: "png" });
const defaultDescription =
  "Richmond Barbershop in Carytown offers precision haircuts, beard trims, and straight razor shaves. Book your appointment today.";

const {
  title = defaultTitle,
  description = defaultDescription,
  canonical = Astro.url.href,
  ogType = 'website',
  editorial = false,
  socialImage = `${WEBSITE_URL}${logoImage.src}`,
  socialImageAlt = 'Richmond Barbershop black lettering and yellow banner logo',
} = Astro.props;

const barbershopSchema = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  "@id": `${WEBSITE_URL}/#business`,
  name: BUSINESS_NAME,
  description: BUSINESS_DESCRIPTION,
  url: WEBSITE_URL,
  image: `${WEBSITE_URL}${logoImage.src}`,
  logo: `${WEBSITE_URL}${logoVector}`,
  telephone: PHONE_E164,
  address: {
    "@type": "PostalAddress",
    ...ADDRESS,
  },
  hasMap: MAPS_URL,
  sameAs: [GOOGLE_PROFILE_URL, APPLE_MAPS_URL, INSTAGRAM_URL, FACEBOOK_URL],
  areaServed: SERVICE_AREAS,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: 'Barber services',
    itemListElement: SERVICES.map((service) => ({
      "@type": "Offer",
      price: service.price,
      priceCurrency: "USD",
      url: `${WEBSITE_URL}${service.path}`,
      itemOffered: { "@type": "Service", "@id": `${WEBSITE_URL}${service.path}#service`, name: service.name, description: service.description, url: `${WEBSITE_URL}${service.path}`, provider: { "@id": `${WEBSITE_URL}/#business` } },
    })),
  },
};

const copyrightYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script
      defer
      src="https://analytics.jakey.fyi/script.js"
      data-website-id="b49bd076-e074-4f7b-8a66-c9aefdb94c0c"></script>
    <link rel="icon" href="/favicon.ico?p=1" type="image/x-icon" />

    <link rel="dns-prefetch" href="//images.unsplash.com" />
    <link rel="dns-prefetch" href="//www.instagram.com" />
    <link rel="dns-prefetch" href="//www.google.com" />
    <link
      rel="preload"
      as="image"
      href={heroImage.src}
      crossorigin="anonymous"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={socialImage}
    />
    <meta
      property="og:image:alt"
      content={socialImageAlt}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={socialImage}
    />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" href="/llms.txt" type="text/plain" title="Richmond Barbershop site guide" />
    <script type="application/ld+json" set:html={JSON.stringify(barbershopSchema)} />
    <slot name="head" />
    <style>
      body {
        font-family: "Oswald", sans-serif;
      }
    </style>
  </head>

  <body class:list={["font-sans", { "editorial-layout": editorial }]}>
    <Navigation />
    <slot />
    <footer
      class="bg-gray-100 dark:bg-zinc-950 text-black dark:text-white border-t border-gray-300 dark:border-zinc-800 py-8 px-4"
    >
      <div class="max-w-7xl mx-auto flex flex-col gap-2 text-center text-sm md:text-base">
        <p class="font-semibold">{BUSINESS_NAME}</p>
        <p>
          <a class="underline" href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a>
          ·
          <a class="underline" href={MAPS_URL} target="_blank" rel="noopener noreferrer"
            >{ADDRESS.streetAddress}, {ADDRESS.addressLocality}, {ADDRESS.addressRegion} {ADDRESS.postalCode}</a
          >
        </p>
        <p>
          {BUSINESS_HOURS_NOTE}
          <a class="underline" href={MAPS_URL} target="_blank" rel="noopener noreferrer"
            >View live hours</a
          >
        </p>
        <p class="flex flex-wrap justify-center gap-x-5 gap-y-2">
          <a class="underline underline-offset-4" href="/about/">About &amp; Visit</a>
          <a class="underline underline-offset-4" href="/guides/">Haircut &amp; Beard Guides</a>
        </p>
        <p class="text-xs opacity-70">&copy; {copyrightYear} {BUSINESS_NAME}. All rights reserved.</p>
      </div>
    </footer>
    <script is:inline define:vars={{ BOOKING_URL }}>
      (() => {
        document.querySelectorAll('a[href]').forEach((link) => {
          const href = link.getAttribute('href') || '';
          if (link.getAttribute('data-umami-event')) {
            return;
          }

          if (href.startsWith('tel:')) {
            link.setAttribute('data-umami-event', 'phone-click');
            return;
          }

          if (href.startsWith(BOOKING_URL)) {
            link.setAttribute('data-umami-event', 'booking-click');
            return;
          }

          if (href.includes('maps.app.goo.gl') || href.includes('google.com/maps')) {
            link.setAttribute('data-umami-event', 'directions-click');
            return;
          }

          if (href.startsWith('http') && link.host !== window.location.host) {
            link.setAttribute('data-umami-event', 'outbound-link-click');
            link.setAttribute('data-umami-event-url', link.href);
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .editorial-layout { background: #fff; color: #18181b; }
  .editorial-layout #mobile-nav, .editorial-layout #desktop-nav { box-shadow: none; border-bottom: 1px solid #d4d4d8; }
  .editorial-layout nav a { border-radius: 0; }
  .editorial-layout nav a:hover { color: #18181b; text-decoration: underline; text-underline-offset: 5px; }
  .editorial-layout nav a[title="Book Now"] { min-width: 44px; min-height: 44px; display: flex; align-items: center; justify-content: center; }
  .editorial-layout #menu { background: #fff; }
  .editorial-layout #menu a { color: #18181b; }
  .editorial-layout #menu a:last-child { color: #fff; background: #18181b; border: 1px solid #18181b; box-shadow: none; transform: none; }
  .editorial-layout #menu a:last-child:hover { color: #18181b; background: #fff; }
  .editorial-layout footer { background: #fff; color: #18181b; border-color: #d4d4d8; padding: 28px 24px; }
  .editorial-layout footer > div { max-width: 1040px; align-items: flex-start; text-align: left; gap: 10px; }
  .editorial-layout footer p { justify-content: flex-start; }
  .editorial-layout a:focus, .editorial-layout button:focus { outline: 2px solid #18181b; outline-offset: 4px; }
  .editorial-layout ::selection { background: #facc15; color: #18181b; }
  @media (prefers-reduced-motion: reduce) { html:has(.editorial-layout) { scroll-behavior: auto; } }
</style>
