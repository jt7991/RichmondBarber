---
import Layout from "./Layout.astro";
import VisitDetails from "../components/VisitDetails.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { BOOKING_URL, BUSINESS_NAME, WEBSITE_URL, SERVICES } from "../data/business";
import { serviceSchema } from "../data/service-schema";
import "../styles/global.css";

interface Props { path: string; title: string; description: string; intro: string; image: ImageMetadata; imageAlt: string; imageCaption: string; }
const { path, title, description, intro, image, imageAlt, imageCaption } = Astro.props;
const canonical = `${WEBSITE_URL}${path}`;
const service = SERVICES.find((item) => item.path === path)!;
const breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: BUSINESS_NAME, item: WEBSITE_URL },
  { "@type": "ListItem", position: 2, name: title, item: canonical },
] };
---
<Layout title={`${title} | ${BUSINESS_NAME}`} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema(path))} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </Fragment>
  <main class="text-black bg-white">
    <header class="px-4 py-16 sm:py-24 bg-gray-50">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="uppercase tracking-widest text-sm mb-4">Richmond Barbershop · Carytown</p>
          <h1 class="text-4xl sm:text-5xl font-bold leading-tight">{title}</h1>
          <p class="text-lg leading-relaxed mt-6">{intro}</p>
          <p class="text-xl font-semibold mt-5">${service.price} · {service.durationMinutes} minutes</p>
          <a href={BOOKING_URL} class="inline-block mt-7 px-7 py-3 bg-black text-white font-bold rounded-lg">Check prices &amp; book</a>
        </div>
        <figure>
          <Image src={image} alt={imageAlt} width={720} widths={[360, 540, 720]} sizes="(min-width: 768px) 492px, calc(100vw - 32px)" format="webp" quality={85} class="w-full h-auto aspect-square object-cover rounded-xl" loading="eager" />
          <figcaption class="text-sm text-gray-600 mt-3">{imageCaption}</figcaption>
        </figure>
      </div>
    </header>
    <div class="service-copy max-w-3xl mx-auto px-4 py-16"><slot /></div>
    <VisitDetails />
  </main>
</Layout>
<style>
  .service-copy :global(h2) { font-size: 1.875rem; line-height: 1.2; font-weight: 700; margin: 2rem 0 1rem; }
  .service-copy :global(h2:first-child) { margin-top: 0; }
  .service-copy :global(p) { font-size: 1.125rem; line-height: 1.75; margin: 1rem 0; }
  .service-copy :global(a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
