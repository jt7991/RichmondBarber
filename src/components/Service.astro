---
import { BOOKING_URL } from "../data/business";
const { service } = Astro.props;
---
<a class="service-row" href={BOOKING_URL} aria-label={`Book ${service.name}, $${service.price}`}>
  <div class="service-title"><h3>{service.name}</h3><span>${service.price}</span></div>
  <p>{service.description}</p>
  <div class="service-bottom"><span>{service.durationMinutes} minutes</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></div>
</a>
<style>
  .service-row { display: block; padding: 24px 0; border-bottom: 1px solid #d4d4d8; color: #18181b; text-decoration: none; text-align: left; }
  .service-row:first-child { padding-top: 0; }
  .service-title { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; font-size: 24px; line-height: 1.25; }
  h3 { margin: 0; font-weight: 500; }
  .service-title span { font-variant-numeric: tabular-nums; white-space: nowrap; }
  p { margin: 12px 0; font-size: 17px; line-height: 1.6; color: #3f3f46; max-width: 70ch; }
  .service-bottom { display: flex; justify-content: space-between; align-items: center; font-size: 14px; color: #52525b; }
  svg { width: 22px; height: 22px; fill: none; stroke: #18181b; stroke-width: 1.5; }
  .service-row:hover h3 { text-decoration: underline; text-underline-offset: 5px; }
  .service-row:focus-visible { outline: 2px solid #18181b; outline-offset: 6px; }
  ::selection { background: #facc15; color: #18181b; }
</style>
