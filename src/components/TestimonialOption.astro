---
import { testimonials } from '../data/testimonials';
interface Props { variant: 'editorial' | 'night' | 'feature' | 'ledger'; }
const { variant } = Astro.props;
---
<section class:list={['reviews', variant]} aria-labelledby={`heading-${variant}`}>
  <div class="review-inner">
    <h2 id={`heading-${variant}`}>What Our<br class="heading-break" /> Clients Say</h2>
    <div class="review-list">
      {testimonials.map((review) => (
        <figure class="review">
          <div class="stars" role="img" aria-label={`${review.rating} out of 5 stars`}>
            {Array.from({ length: review.rating }, () => (
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 1.5 2.6 5.3 5.9.8-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9L1.5 7.6l5.9-.8Z" /></svg>
            ))}
          </div>
          <blockquote>&ldquo;{review.text}&rdquo;</blockquote>
          <figcaption>
            <cite>{review.name}</cite>
            <time datetime={review.date}>{review.dateLabel}</time>
            <a href={review.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`Read ${review.name}'s reviews on Google (opens in a new tab)`}>Google review excerpt</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .reviews { --surface: #fff; --ink: #18181b; --muted: #52525b; --rule: #d4d4d8; background: var(--surface); color: var(--ink); padding: clamp(48px, 7vw, 100px) 24px; }
  .review-inner { max-width: 1120px; margin-inline: auto; }
  h2 { font-family: 'Oswald', sans-serif; font-size: clamp(36px, 4.7vw, 64px); font-weight: 500; line-height: 1.08; letter-spacing: -.025em; text-wrap: balance; margin: 0 0 48px; }
  .heading-break { display: none; }
  .review-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .review { margin: 0; min-width: 0; display: flex; flex-direction: column; }
  .stars { display: flex; gap: 4px; margin-bottom: 24px; color: #8b6500; }
  .stars svg { width: 18px; height: 18px; fill: currentColor; }
  blockquote { margin: 0 0 32px; font-size: 20px; line-height: 1.6; text-wrap: pretty; }
  figcaption { margin-top: auto; display: flex; flex-direction: column; align-items: flex-start; gap: 5px; font-size: 13px; color: var(--muted); }
  cite { font-style: normal; font-size: 16px; font-weight: 700; color: var(--ink); }
  a { color: inherit; text-decoration: underline; text-underline-offset: 4px; min-height: 28px; display: inline-flex; align-items: center; }
  a:hover { color: var(--ink); text-decoration-thickness: 2px; }
  a:focus-visible { outline: 2px solid var(--ink); outline-offset: 5px; border-radius: 2px; }
  ::selection { background: #facc15; color: #18181b; }

  .editorial .review-inner { border-top: 2px solid var(--ink); padding-top: 32px; }
  .editorial h2 { max-width: 540px; }
  .editorial .review + .review { border-left: 1px solid var(--rule); padding-left: 32px; }
  .editorial blockquote { font-size: clamp(20px, 2vw, 25px); }

  .night { --surface: #18181b; --ink: #fafafa; --muted: #d4d4d8; --rule: #52525b; }
  .night h2 { text-align: center; margin-bottom: 64px; }
  .night .review { text-align: center; padding: 32px 12px 0; border-top: 1px solid var(--rule); }
  .night .stars { justify-content: center; color: #facc15; }
  .night figcaption { align-items: center; }
  .night blockquote { font-size: 22px; }
  .night cite { color: #facc15; }

  .feature { --surface: #facc15; --ink: #18181b; --muted: #3f3305; --rule: #8b720b; }
  .feature .review-inner { display: grid; grid-template-columns: 1fr 2fr; gap: 64px; }
  .feature .heading-break { display: block; }
  .feature h2 { font-size: clamp(40px, 4.7vw, 64px); }
  .feature .review-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .feature .review:first-child { grid-column: 1 / -1; padding-bottom: 36px; border-bottom: 1px solid var(--rule); }
  .feature .review:first-child blockquote { font-size: clamp(26px, 3vw, 38px); line-height: 1.35; letter-spacing: -.02em; }
  .feature .stars { color: var(--ink); }
  .feature ::selection { background: #18181b; color: #facc15; }

  .ledger .review-inner { display: grid; grid-template-columns: 1fr 2fr; gap: 80px; }
  .ledger .heading-break { display: block; }
  .ledger .review-list { display: block; }
  .ledger .review { display: grid; grid-template-columns: 1fr auto; gap: 20px 24px; border-top: 1px solid var(--rule); padding-block: 28px; }
  .ledger .review:first-child { border-color: var(--ink); }
  .ledger .stars { grid-column: 2; grid-row: 1; margin: 0; align-self: center; gap: 1px; }
  .ledger .stars svg { width: 14px; height: 14px; }
  .ledger blockquote { grid-column: 1 / -1; grid-row: 2; margin: 0; }
  .ledger figcaption { grid-column: 1; grid-row: 1; margin: 0; }
  .ledger figcaption a { grid-column: 1 / -1; }

  @media (max-width: 760px) {
    .reviews { padding-inline: 24px; }
    .review-list { grid-template-columns: 1fr; gap: 32px; }
    .editorial .review + .review { border-left: 0; padding-left: 0; padding-top: 28px; border-top: 1px solid var(--rule); }
    .feature .review-inner, .ledger .review-inner { grid-template-columns: 1fr; gap: 12px; }
    .feature .review-list { grid-template-columns: 1fr; }
    .feature .review:first-child { grid-column: auto; }
    .feature .review + .review + .review { padding-top: 28px; border-top: 1px solid var(--rule); }
    .heading-break, .feature .heading-break, .ledger .heading-break { display: none; }
    h2 { margin-bottom: 36px; }
    .night h2 { margin-bottom: 36px; }
    .night .review { padding-inline: 0; }
    .ledger .review { column-gap: 12px; }
  }
</style>
