---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { galleryPhotos } from "../data/gallery";
import { BOOKING_URL } from "../data/business";
interface Props {
  slugs?: string[];
  photos?: { src: ImageMetadata; alt: string; caption: string }[];
}
const photos = Astro.props.photos ?? (Astro.props.slugs ?? []).map((slug) => galleryPhotos.find((photo) => photo.slug === slug)).filter((photo) => photo !== undefined);
---
<section class="max-w-5xl mx-auto px-4 py-12" aria-label="Examples of our work">
  <h2 class="text-3xl font-bold mb-4">See Our Work</h2>
  <p class="text-lg leading-relaxed mb-6">Explore finished work from Richmond Barbershop. Bring a reference photo to your appointment so we can discuss the length, shape, and finish you want.</p>
  <div class="grid sm:grid-cols-2 gap-6">
    {photos.map((photo) => <figure>
      <a href={BOOKING_URL} aria-label={`Book an appointment — ${photo.caption}`}>
        <Image src={photo.src} alt={photo.alt} width={640} widths={[320, 480, 640]} sizes="(min-width: 640px) 480px, calc(100vw - 32px)" format="webp" loading="lazy" class="w-full h-auto aspect-square object-cover rounded-lg" />
      </a>
      <figcaption class="mt-3 text-lg">{photo.caption}</figcaption>
    </figure>)}
  </div>
  <a href={BOOKING_URL} class="inline-block mt-6 px-7 py-3 bg-black text-white rounded-lg font-bold">Find an appointment</a>
</section>
