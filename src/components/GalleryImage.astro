---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  id: string;
  index: number;
  classNames?: string;
  caption?: string;
  fullSrc?: string;
}
const { src, alt, id, index, classNames = "", caption, fullSrc } = Astro.props;
const MediaTag = fullSrc ? "a" : "div";
const widths = [...new Set([320, 480, 640, 960].filter((width) => width < src.width).concat(Math.min(960, src.width)))];
---

<figure id={`${id}-checker`} data-gallery-item style={`--gallery-delay: ${(index % 3) * 60}ms`}>
  <MediaTag href={fullSrc} class="gallery-media" aria-label={fullSrc ? `View larger photo: ${caption}` : undefined}>
    <Image
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      width={Math.min(960, src.width)}
      widths={widths}
      sizes="(min-width: 1088px) 336px, (min-width: 761px) calc((100vw - 80px) / 3), calc((100vw - 60px) / 2)"
      format="webp"
      class:list={["gallery-photo", classNames]}
      id={id}
      quality={82}
    />
  </MediaTag>
</figure>

<style>
  figure { min-width: 0; margin: 0; }
  .gallery-media { display: block; overflow: hidden; }
  .gallery-photo { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  a.gallery-media:hover { outline: 1px solid #18181b; outline-offset: 3px; }
  a.gallery-media:focus-visible { outline: 2px solid #18181b; outline-offset: 4px; }
</style>
