---
import { Image } from "astro:assets";
import logo from "../assets/richmond-barbershop-new-logo.png";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={["brand-logo", { "brand-logo--compact": compact }]}>
  <Image
    src={logo}
    alt="Richmond Barbershop"
    widths={compact ? [240, 480] : [640, 960, 1600]}
    sizes={compact ? "112px" : "(max-width: 640px) 80vw, 560px"}
    format="webp"
    quality={90}
    loading="eager"
    fetchpriority={compact ? "auto" : "high"}
  />
</div>

<style>
  .brand-logo {
    width: min(100%, 600px);
    padding: clamp(12px, 3vw, 28px);
    margin-bottom: clamp(24px, 4vw, 40px);
    background: white;
    border-radius: 4px;
    box-shadow: 0 16px 48px rgb(0 0 0 / 18%);
  }
  .brand-logo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.9;
    /* Frame the original square upload without altering its artwork.
       The visible mark occupies y=463-1214 in the 1600px source. */
    object-fit: cover;
    object-position: center 55%;
  }
  .brand-logo--compact {
    width: 112px;
    padding: 0;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
  }
</style>
