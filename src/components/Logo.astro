---
import logo from "../assets/richmond-barbershop-logo.svg?url";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div id={compact ? undefined : "logo"} class:list={["brand-logo", { "brand-logo--compact": compact }]}>
  <img
    src={logo}
    alt="Richmond Barbershop"
    width="1494"
    height="755"
    loading="eager"
    fetchpriority={compact ? "auto" : "high"}
  />
</div>

<style>
  .brand-logo {
    width: min(100%, 600px);
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .brand-logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .brand-logo--compact {
    width: 112px;
    padding: 0;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .brand-logo:not(.brand-logo--compact) img {
      animation: reveal-logo 700ms ease-out both;
    }
    @keyframes reveal-logo {
      from { opacity: 0; transform: scale(0.75); }
      to { opacity: 1; transform: scale(1); }
    }
  }
</style>
