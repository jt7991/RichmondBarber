---
import { ADDRESS_SINGLE_LINE, BOOKING_URL, BUSINESS_HOURS_NOTE, MAPS_URL, PHONE_DISPLAY, PHONE_E164, SERVICES, HAIRCUT_BEARD_COMBO } from "../data/business";
---
<section class="px-4 py-16 bg-gray-50 text-black" aria-label="Plan your barbershop visit">
  <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10">
    <div>
      <h2 class="text-3xl font-bold mb-4">Visit us in Carytown</h2>
      <address class="not-italic text-lg leading-relaxed">
        {ADDRESS_SINGLE_LINE}<br />
        <a href={`tel:${PHONE_E164}`} class="underline">{PHONE_DISPLAY}</a>
      </address>
      <p class="mt-4 leading-relaxed">Appointments are recommended; walk-ins are welcome when available. Haircuts are available for ages 8 and up.</p>
      <p class="mt-3 leading-relaxed">Street parking and a parking garage directly across the street are available. We do not have onsite parking.</p>
      <p class="mt-3 leading-relaxed">{BUSINESS_HOURS_NOTE}</p>
      <div class="flex flex-wrap gap-5 mt-5">
        <a class="underline font-semibold" href={MAPS_URL}>Get directions &amp; current hours</a>
        <a class="underline font-semibold" href="/about/">About the shop</a>
      </div>
    </div>
    <div>
      <h2 class="text-3xl font-bold mb-4">Find your service</h2>
      <ul class="space-y-3 text-lg">
        {SERVICES.map((service) => <li class="flex flex-wrap justify-between gap-x-4"><a href={service.path} class="underline underline-offset-4">{service.name}</a><span>${service.price} · {service.durationMinutes} min</span></li>)}
      </ul>
      <p class="mt-5 leading-relaxed">Haircut and beard trim with Joe or Sam: ${HAIRCUT_BEARD_COMBO.price} · {HAIRCUT_BEARD_COMBO.durationMinutes} minutes.</p>
      <p class="mt-3 text-sm text-gray-600">Prices and durations from our booking menu. Check Square for the latest availability and service details.</p>
      <a href={BOOKING_URL} class="inline-block mt-5 bg-black text-white rounded-lg px-7 py-3 font-bold">Check availability &amp; book</a>
    </div>
  </div>
</section>
