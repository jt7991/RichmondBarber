---
import Layout from "../layouts/Layout.astro";
import VisitDetails from "../components/VisitDetails.astro";
import { Image } from "astro:assets";
import interior from "../assets/barbershop_interior.webp";
import { BUSINESS_DESCRIPTION, BUSINESS_NAME, BOOKING_URL, GOOGLE_PROFILE_URL, SERVICES, WEBSITE_URL, BARBERS } from "../data/business";
import "../styles/global.css";
const haircut = SERVICES.find((service) => service.path === "/mens-haircut-richmond-va/")!;
const haircutBookingUrl = `${BOOKING_URL}/UXBCSR3DPEYGVY3OBVTLUFPX`;
const canonical = `${WEBSITE_URL}/about/`;
const schema = { "@context": "https://schema.org", "@type": "AboutPage", "@id": `${canonical}#page`, url: canonical, name: `About ${BUSINESS_NAME}`, description: BUSINESS_DESCRIPTION, about: { "@id": `${WEBSITE_URL}/#business` }, mentions: BARBERS.map((barber) => ({ "@type": "Person", "@id": `${canonical}#${barber.id}`, name: barber.name, jobTitle: "Barber", worksFor: { "@id": `${WEBSITE_URL}/#business` } })) };
---
<Layout title="About Richmond Barbershop | Visit Our Carytown Shop" description={BUSINESS_DESCRIPTION} canonical={canonical}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)} /></Fragment>
  <main class="bg-white text-black">
    <header class="px-4 py-16 sm:py-24 bg-gray-50">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="uppercase tracking-widest text-sm mb-4">Carytown · Richmond, Virginia</p>
          <h1 class="text-4xl sm:text-5xl font-bold">Your neighborhood barbershop</h1>
          <p class="text-lg leading-relaxed mt-6">{BUSINESS_DESCRIPTION}</p>
          <p class="text-lg leading-relaxed mt-4">Our privately owned shop brings old-school barbering traditions to West Cary Street. Explore our work, choose your service, and plan your visit.</p>
          <a href={BOOKING_URL} class="inline-block mt-6 bg-black text-white font-bold rounded-lg px-7 py-3">Find an appointment</a>
        </div>
        <Image src={interior} alt="Barber chairs, mirrors, and checkerboard floor inside our Carytown barbershop" width={720} widths={[360,540,720]} sizes="(min-width: 768px) 492px, calc(100vw - 32px)" format="webp" class="w-full h-auto aspect-square object-cover rounded-xl" loading="eager" />
      </div>
    </header>
    <section class="max-w-5xl mx-auto px-4 py-16">
      <h2 class="text-3xl font-bold mb-8">Why choose Richmond Barbershop?</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div><h3 class="text-xl font-bold mb-3">See the work</h3><p class="leading-relaxed">Our gallery shows finished styles, from longer layered shapes to textured cuts, tapers, and beard work.</p><a href="/#gallery" class="inline-block underline mt-4">Explore our haircut gallery</a></div>
        <div><h3 class="text-xl font-bold mb-3">Choose your service</h3><ul class="space-y-2">{SERVICES.map((service) => <li><a href={service.path} class="underline">{service.name}</a></li>)}</ul></div>
        <div><h3 class="text-xl font-bold mb-3">Plan with confidence</h3><p class="leading-relaxed">Check current prices and available appointments online. Call before booking if you need help choosing a service.</p><a href={BOOKING_URL} class="inline-block underline mt-4">Check appointment availability</a></div>
      </div>
    </section>
    <section class="px-4 pb-16 max-w-5xl mx-auto grid md:grid-cols-2 gap-10">
      <div><h2 class="text-3xl font-bold mb-4">Meet your barbers</h2>
        <p class="text-lg leading-relaxed mb-5">Book a ${haircut.price} haircut with Joe or Sam. Your appointment includes a hot towel and straight-razor neck shave. Choose your barber after selecting the haircut service.</p>
        <div class="grid sm:grid-cols-2 gap-4">
          {BARBERS.map((barber) => <article id={barber.id} class="border border-gray-200 rounded-xl p-5"><h3 class="text-2xl font-bold">{barber.name}</h3><p class="mt-3">Haircut<br />${haircut.price} · {haircut.durationMinutes} minutes</p><a href={haircutBookingUrl} class="inline-block underline mt-4">Book a haircut with {barber.name}</a></article>)}
        </div>
      </div>
      <div><h2 class="text-3xl font-bold mb-4">Customer recommendations</h2><blockquote class="border-l-4 border-yellow-300 pl-5 text-xl leading-relaxed">“Joe T is the nicest dude and solid service.”</blockquote><p class="mt-3 text-sm">A public customer recommendation on <a class="underline" href="https://www.reddit.com/r/rva/comments/1w3xlwb/barber_recommendations/">r/rva</a>.</p><a class="inline-block underline mt-4" href={GOOGLE_PROFILE_URL}>View our Google Business Profile and reviews</a></div>
    </section>
    <VisitDetails />
  </main>
</Layout>
