---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Accordion from "../components/Accordion.astro";
import Logo from "../components/Logo.astro";
import Service from "../components/Service.astro";
import GalleryImage from "../components/GalleryImage.astro";
import { galleryPhotos, gallerySchema } from "../data/gallery";
import TestimonialOption from "../components/TestimonialOption.svelte";
import { Image } from "astro:assets";
import heroImage from "../assets/barbershop_interior.webp";
import client_1 from "../assets/client_1.webp";
import client_2 from "../assets/client_2.webp";
import client_3 from "../assets/client_3.webp";
import client_4 from "../assets/client_4.webp";
import client_5 from "../assets/client_5.webp";
import client_6 from "../assets/client_6.webp";
import beard_guy from "../assets/beard_guy.webp"
import toby from "../assets/toby.webp";
import {
  ADDRESS,
  BOOKING_URL,
  BUSINESS_DESCRIPTION,
  FAQS,
  SERVICES,
  FACEBOOK_URL,
  INSTAGRAM_URL,
  MAPS_URL,
  PHONE_DISPLAY,
  PHONE_E164,
  WEBSITE_URL,
} from "../data/business";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout
  title="Richmond Barber in Carytown | Richmond Barbershop"
  description="Visit our Carytown barbershop in Richmond, VA for precision men's haircuts, fades, scissor cuts, beard trims, and hot towel shaves. Book your next visit."
  canonical={`${WEBSITE_URL}/`}
  editorial
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(gallerySchema)}></script>
  </Fragment>
  <main class="editorial-home">
    <section id="hero" class="hero" aria-label="Richmond Barbershop">
      <div class="hero-grid">
        <div class="hero-brand">
          <Logo />
          <a class="editorial-button" href={BOOKING_URL}>Book Now
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
          </a>
        </div>
        <Image src={heroImage} alt="Barber chairs and checkerboard floor inside Richmond Barbershop in Carytown" width={900} widths={[360, 540, 720, 900]} sizes="(min-width: 1100px) 520px, (min-width: 761px) 50vw, calc(100vw - 48px)" loading="eager" fetchpriority="high" class="hero-photo" />
      </div>
    </section>

    <section id="best-barbershop" class="editorial-section" data-ai-section="best-barbershop-in-richmond" data-ai-type="best-barbershop-in-richmond">
      <div class="section-inner introduction">
        <h1>Looking for the best barbershop in Richmond Virginia?</h1>
        <div class="section-content"><p>{BUSINESS_DESCRIPTION} Visit us at 2820 W Cary St, Suite C, and explore our work below.</p></div>
      </div>
    </section>

    <section id="gallery" class="editorial-section" data-ai-section="gallery" data-ai-type="work-samples">
      <div class="section-inner gallery-heading">
        <h2>Gallery</h2>
        <div class="section-content"><p>Fresh haircuts, textured styles, tapers, and beard work from our chairs in Carytown, Richmond, VA.</p></div>
      </div>
      <div class="gallery-grid">
        {galleryPhotos.map((photo, index) => (
          <GalleryImage index={index} id={photo.slug} src={photo.src} alt={photo.alt} caption={photo.caption} fullSrc={photo.full.src} />
        ))}
        {[
          { src: toby, id: 'image7', alt: 'Toby getting a premium haircut at Richmond Barbershop' },
          { src: client_1, id: 'image1', alt: 'Man receiving a professional haircut at Richmond Barbershop in Richmond VA' },
          { src: client_2, id: 'image2', alt: 'Skilled barber performing a haircut at Richmond VA barbershop' },
          { src: client_5, id: 'image5', alt: 'Modern haircut service at Richmond Barbershop in Virginia' },
          { src: client_3, id: 'image3', alt: 'Client enjoying a stylish haircut at Richmond Barbershop' },
          { src: client_4, id: 'image4', alt: 'Professional haircut at Richmond Barbershop in Richmond, VA' },
          { src: client_6, id: 'image6', alt: 'Expert barber cutting hair at Richmond VA location' },
          { src: beard_guy, id: 'image8', alt: 'A man with a beard who just got a professional beard trim with a straight razor line up in Richmond, Virginia' },
        ].map((photo, index) => <GalleryImage {...photo} index={index} classNames={photo.id === 'image8' ? 'object-top' : ''} />)}
      </div>
    </section>

    <section id="services" class="editorial-section" data-ai-section="services" data-ai-type="barber-services">
      <div class="section-inner">
        <h2>Our Services</h2>
        <div class="section-content">
          <div class="service-list">{SERVICES.map((service) => <Service service={service} />)}</div>
          <p class="service-note">Learn more about our <a href="/mens-haircut-richmond-va">men's haircut in Richmond, VA</a>, <a href="/beard-trim-richmond-va">beard trim</a>, <a href="/scissor-cut-richmond-va">scissor cut</a>, and <a href="/straight-razor-shave-richmond-va">straight-razor shave</a> services. <a href="/about/">Get to know the shop and plan your visit.</a></p>
        </div>
      </div>
    </section>

    <section id="faq" class="editorial-section" data-ai-section="faq" data-ai-type="frequently-asked-questions">
      <div class="section-inner">
        <h2>FAQ</h2>
        <div class="section-content">
          {FAQS.map((faq) => <Accordion title={faq.question}>{faq.answer}</Accordion>)}
          <a class="text-booking" href={BOOKING_URL}>Book an appointment on Square</a>
        </div>
      </div>
    </section>

    <TestimonialOption variant="editorial" client:load />

    <section id="contact" class="editorial-section">
      <div class="section-inner">
        <h2>Contact Us</h2>
        <div class="section-content">
          <div class="contact-details">
            <div>
              <a class="contact-phone" href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a>
              <address>{ADDRESS.streetAddress}<br />{ADDRESS.addressLocality}, {ADDRESS.addressRegion} {ADDRESS.postalCode}</address>
              <div class="social-links"><a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">Instagram</a><a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer">Facebook</a></div>
            </div>
            <a class="editorial-button directions" href={MAPS_URL} target="_blank" rel="noopener noreferrer">Get Directions
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
            </a>
          </div>
          <iframe title="Richmond Barbershop location in Carytown" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d790.7805099320608!2d-77.47802503034775!3d37.55218841147862!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89b113db68bc08b1%3A0x9ca083c0e9faa6c0!2sRichmond%20Barbershop!5e0!3m2!1sen!2sus!4v1766692323074!5m2!1sen!2sus" width="100%" height="320" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>
  </main>

</Layout>

<style>
  .editorial-home { background: #fff; color: #18181b; }
  section { scroll-margin-top: 88px; }
  .hero { padding: 24px 24px 48px; }
  .hero-grid { max-width: 1040px; margin: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .hero-brand { display: flex; flex-direction: column; align-items: flex-start; padding-block: 24px; }
  .hero-brand :global(.brand-logo) { width: 100%; max-width: 400px; margin-bottom: 32px; }
  .hero-brand :global(.brand-logo img) { animation: none; }
  .hero-photo { width: 100%; height: auto; aspect-ratio: 1.12; object-fit: cover; }
  .editorial-button { display: inline-flex; gap: 28px; align-items: center; justify-content: space-between; padding: 14px 20px; min-height: 48px; background: #18181b; color: #fff; border: 1px solid #18181b; font-size: 18px; text-decoration: none; }
  .editorial-button svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .editorial-button:hover { color: #18181b; background: #fff; }
  .editorial-section { padding: 40px 24px; }
  .section-inner { max-width: 1040px; margin-inline: auto; border-top: 2px solid #18181b; padding-top: 28px; display: grid; grid-template-columns: 1fr 2fr; gap: 64px; }
  h1, h2 { font-family: 'Oswald', sans-serif; font-weight: 500; letter-spacing: -.025em; line-height: 1.12; text-wrap: balance; margin: 0; }
  h1 { font-size: clamp(30px, 3.5vw, 42px); }
  h2 { font-size: clamp(32px, 4vw, 48px); }
  .section-content { min-width: 0; border-left: 1px solid #a1a1aa; padding-left: 40px; }
  p { font-size: 20px; line-height: 1.6; color: #3f3f46; margin: 0; max-width: 70ch; text-wrap: pretty; }
  .introduction .section-content { display: flex; align-items: flex-start; }
  .gallery-heading { margin-bottom: 32px; }
  .gallery-grid { max-width: 1040px; margin-inline: auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .service-note { font-size: 16px; margin-top: 24px; }
  a:not(.editorial-button) { text-decoration: underline; text-underline-offset: 4px; }
  a:not(.editorial-button):hover { text-decoration-thickness: 2px; }
  a:focus-visible { outline: 2px solid #18181b; outline-offset: 5px; }
  .text-booking { display: inline-flex; padding-block: 12px; margin-top: 16px; font-size: 17px; }
  .contact-details { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; margin-bottom: 28px; }
  .contact-phone { font-size: 28px; display: inline-block; padding-block: 4px; }
  address { font-style: normal; font-size: 20px; line-height: 1.5; margin-top: 16px; }
  .social-links { display: flex; gap: 24px; margin-top: 12px; }
  .social-links a { padding-block: 8px; }
  .directions { font-size: 16px; gap: 16px; flex-shrink: 0; }
  iframe { width: 100%; display: block; }
  #contact { padding-bottom: 64px; }
  ::selection { background: #facc15; color: #18181b; }
  @media (max-width: 760px) {
    .hero { padding: 16px 24px 24px; }
    .hero-grid { grid-template-columns: 1fr; gap: 24px; }
    .hero-brand { padding-block: 16px 0; }
    .hero-brand :global(.brand-logo) { max-width: 260px; margin-bottom: 24px; }
    .hero-photo { aspect-ratio: 1.65; }
    .editorial-section { padding-block: 24px; }
    .section-inner { grid-template-columns: 1fr; gap: 24px; }
    .section-content { border-left: 0; padding-left: 0; }
    .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .contact-details { flex-direction: column; gap: 20px; }
    p { font-size: 18px; }
    iframe { height: 280px; }
    #contact { padding-bottom: 40px; }
  }
</style>
